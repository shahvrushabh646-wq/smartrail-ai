{
  "manifest_version": 3,
  "name": "SmartRail AI — IRCTC Availability Bridge",
  "version": "0.3.0",
  "description": "Automatically fills and submits your journey in IRCTC from SmartRail and bridges visible availability back to the app.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.irctc.co.in/*",
    "https://*.vercel.app/*",
    "https://smartrail-ai-mu.vercel.app/*",
    "https://smartrail-git-feature-visible-irctc-extension-v2-vs-38ee.vercel.app/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.irctc.co.in/*"
      ],
      "js": [
        "irctc-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vercel.app/*",
        "https://smartrail-ai-mu.vercel.app/*",
        "https://smartrail-git-feature-visible-irctc-extension-v2-vs-38ee.vercel.app/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "smartrail-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
