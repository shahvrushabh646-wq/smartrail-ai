PORT=4100

# Optional independent train-data provider. Create a key at https://railcore.tech/developers
# Keep this secret in Vercel Environment Variables; never expose it in frontend code.
RAILCORE_KEY=
# Number of upcoming direct trains to check. ALL checks every upcoming train and every returned class.
# Each train/class check consumes provider usage; set a positive integer to cap usage deliberately.
RAILCORE_AVAILABILITY_LIMIT=ALL

# Optional independent timetable/connecting-route fallback. Its free plan is quota-limited.
# Keep this key server-side; never expose it in frontend code.
RAILRADAR_API_KEY=
# Maximum route/class seat checks per search (1-24); each connecting leg consumes a separate request.
RAILRADAR_AVAILABILITY_LIMIT=24
# Seat quota used by RailRadar fallback (GN=General, TQ=Tatkal, etc.).
RAILRADAR_QUOTA=GN

# Optional custom authorised availability adapter for locally imported split routes.
RAIL_AVAILABILITY_URL=
RAIL_API_KEY=

# Optional private-use IRCTC.dev feed. Obtain your own key at https://irctc.dev/dashboard.
# This is an independent third-party service, not an official IRCTC/Indian Railways API.
IRCTC_API_KEY=
# Required shared private code; only the owner should know it. Enter it in SmartRail's search form.
SMARTRAIL_PERSONAL_ACCESS_CODE=
# Maximum number of direct trains to check (1-5, default 2); ALL classes may use multiple requests per train.
IRCTC_DEV_AVAILABILITY_LIMIT=2
